# Copy to .env.publish (gitignored) and fill in. Never commit the real file.
# From Cloudflare dashboard → R2 → your bluespot bucket:
#   • "Manage R2 API Tokens" → create token, Object Read & Write,
#     scoped to THIS bucket only → gives the two keys below
#   • the endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   • the public base is the bucket's r2.dev URL (or your custom domain)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=bluespot
R2_PUBLIC_BASE=https://pub-<hash>.r2.dev/
